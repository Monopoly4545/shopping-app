# Postgres connection string used by the app and the seed scripts.
DATABASE_URL=postgresql://user:password@localhost:5432/shopping_app

# Secret used to verify signed payment-provider webhooks
# (HMAC-SHA256 of the raw request body, sent in the x-payment-signature header).
# Generate a long random value for production, e.g. `openssl rand -hex 32`.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
